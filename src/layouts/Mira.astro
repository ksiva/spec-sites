---
import "../kit/kit.css";
import data from "../data/mira.json";
import { url } from "../lib.js";

interface Props { title?: string; description?: string; active?: string; }
const { title, description = data.intro, active = "" } = Astro.props;
const fullTitle = title ? `${title} | ${data.name}` : `${data.name}, ${data.role}`;
const nav = [["Films", "/mira-castellane/#films"], ["About", "/mira-castellane/about/"], ["Notes", "/mira-castellane/notes/"], ["Contact", "/mira-castellane/contact/"]];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(url("/media/hd/m-horses.jpg"), Astro.site)} />
    <meta name="robots" content="noindex" />
    <link rel="icon" href={`data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' fill='%230c0b0a'/><text x='16' y='23' font-size='20' text-anchor='middle' fill='%23ece6dc' font-family='Georgia' font-style='italic'>M</text></svg>`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="nav">
      <a href={url("/mira-castellane/")} class="brand" data-magnetic>Mira Castellane</a>
      <span class="clock mono" aria-label="Toronto time"><span class="rec"></span>Toronto <span id="clock">--:--</span></span>
      <nav aria-label="Main"><ul>{nav.map(([l, h]) => <li><a href={url(h)} class:list={[{ active: active === l }]}>{l}</a></li>)}</ul></nav>
      <button class="menu-btn" aria-expanded="false" aria-controls="m-menu">Menu</button>
    </header>
    <div id="m-menu" class="m-menu" hidden>
      <ul>{nav.map(([l, h]) => <li><a href={url(h)}>{l}</a></li>)}</ul>
    </div>
    <main><slot /></main>
    <footer class="footer">
      <div class="credits" data-reveal="stagger">
        <p class="mono">End credits</p>
        <p class="big"><em>Directed by</em> Mira Castellane</p>
        <p class="big"><em>Represented in Canada by</em> in-house</p>
        <p class="big"><em>Say hello</em> <a href={url("/mira-castellane/contact/")}>mira@castellane.example</a></p>
      </div>
      <p class="note mono">Concept site by Siva. Mira Castellane, her clients and crew are fictional. Footage: Pexels.</p>
    </footer>
    <script>
      import { initMotion } from "../kit/motion.js";
      initMotion();
      const navEl = document.querySelector(".nav");
      const setSolid = () => navEl?.classList.toggle("is-solid", scrollY > 40);
      setSolid(); addEventListener("scroll", setSolid, { passive: true });
      const el = document.getElementById("clock");
      const tick = () => { if (el) el.textContent = new Intl.DateTimeFormat("en-CA", { timeZone: "America/Toronto", hour: "2-digit", minute: "2-digit", hour12: false }).format(new Date()); };
      tick(); setInterval(tick, 15000);
      const btn = document.querySelector(".menu-btn");
      const menu = document.getElementById("m-menu");
      btn?.addEventListener("click", () => {
        const open = btn.getAttribute("aria-expanded") === "true";
        btn.setAttribute("aria-expanded", String(!open));
        btn.textContent = open ? "Menu" : "Close";
        if (menu) menu.hidden = open;
      });
    </script>
  </body>
</html>
<style is:global>
  :root {
    --bg: #0c0b0a; --fg: #ece6dc; --dim: #8a8378; --line: #2a2723; --accent: #d38b4f;
    --kit-fg: #fff; --kit-bg: var(--bg); --kit-accent: var(--accent); --kit-mono: "JetBrains Mono", monospace; --kit-display: "Instrument Serif", serif; --kit-curtain: #0c0b0a;
    --pad: clamp(16px, 3vw, 40px);
  }
  * { box-sizing: border-box; }
  html { background: var(--bg); }
  body { margin: 0; background: var(--bg); color: var(--fg); font: 400 16px/1.55 Inter, system-ui, sans-serif; -webkit-font-smoothing: antialiased; }
  a { color: inherit; text-decoration: none; }
  img, video { display: block; max-width: 100%; }
  h1, h2, h3 { font-family: "Instrument Serif", Georgia, serif; font-weight: 400; letter-spacing: -0.02em; line-height: .95; margin: 0; }
  .mono { font: 500 11px/1.4 "JetBrains Mono", monospace; letter-spacing: .1em; text-transform: uppercase; color: var(--dim); }
  .wrap { padding: 0 var(--pad); }
  .nav { position: fixed; left: 0; right: 0; top: 0; z-index: 50; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 16px; padding: 18px var(--pad); transition: background .4s, backdrop-filter .4s; }
  .nav.is-solid { background: color-mix(in srgb, var(--bg) 82%, transparent); backdrop-filter: blur(10px); }
  main { min-height: 60vh; }
  .brand { font-family: "Instrument Serif", serif; font-size: 24px; letter-spacing: -0.01em; justify-self: start; }
  .clock { display: inline-flex; align-items: center; gap: 8px; }
  .rec { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); animation: blink 1.6s infinite; }
  @keyframes blink { 50% { opacity: .2; } }
  .nav ul { list-style: none; display: flex; gap: 22px; margin: 0; padding: 0; justify-self: end; font-size: 14px; }
  .nav a { background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat; transition: background-size .5s cubic-bezier(.2,.8,.2,1); padding-bottom: 2px; }
  .nav a:hover, .nav a.active { background-size: 100% 1px; }
  .brand { white-space: nowrap; }
  .menu-btn { display: none; background: none; border: 0; color: inherit; font: inherit; font-size: 14px; padding: 8px 0; justify-self: end; }
  .m-menu { position: fixed; inset: 0; z-index: 40; background: var(--bg); padding: 110px var(--pad) var(--pad); }
  .m-menu ul { list-style: none; margin: 0; padding: 0; }
  .m-menu a { display: block; font-family: "Instrument Serif", serif; font-size: 52px; padding: 6px 0; border-bottom: 1px solid var(--line); }
  @media (max-width: 720px) { .clock, .nav nav { display: none; } .menu-btn { display: block; } .nav { grid-template-columns: auto auto; justify-content: space-between; } .brand { font-size: 20px; } }
  .footer { background: #070706; color: #ece6dc; padding: clamp(100px, 12vw, 180px) var(--pad) 28px; margin-top: clamp(100px, 12vw, 180px); text-align: center; }
  .footer .mono { color: #8c857a; }
  .credits .big { font-family: "Instrument Serif", serif; font-size: clamp(30px, 5vw, 72px); line-height: 1.1; margin: 0 0 .3em; }
  .credits em { display: block; font-family: Inter, sans-serif; font-style: normal; font-size: 13px; letter-spacing: .08em; text-transform: uppercase; color: #8c857a; margin-bottom: 4px; }
  .credits a { border-bottom: 1px solid #8c857a; }
  .note { margin: clamp(80px, 10vw, 140px) 0 0; }
</style>
