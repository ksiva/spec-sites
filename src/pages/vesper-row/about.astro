---
import Layout from "../../layouts/Vesper.astro";
import { media } from "../../lib.js";
const facts = [["2014", "Founded in Toronto"], ["2", "Offices, Toronto and Los Angeles"], ["3", "Directors on the roster"], ["2", "Stages of our own"]];
---
<Layout title="About" active="About" description="Vesper Row is an independent commercial production company in Toronto and Los Angeles.">
  <header class="page-head">
    <h1 data-split>Made by people who still love making things.</h1>
  </header>
  <section class="split wrap">
    <div class="split__img"><img src={media("hd/norway.jpg")} alt="Aerial view of a valley road in northern light" data-parallax="0.12" /></div>
    <div class="split__text" data-reveal="stagger">
      <p>Vesper Row is an independent production company. We produce commercials and branded films for agencies and brands across Canada and the US.</p>
      <p>We keep crews small and decisions close to the camera. Every job has one producer from the first call to the final grade, so nothing gets lost between people.</p>
      <p>Our directors choose their projects. That is why the work looks like theirs.</p>
    </div>
  </section>
  <section class="facts wrap" data-reveal="stagger">
    {facts.map(([n, t]) => <div><span class="facts__n">{n}</span><span class="mono">{t}</span></div>)}
  </section>
</Layout>
<style>
  .page-head h1 { font-size: clamp(40px, 7.5vw, 120px); max-width: 14ch; }
  .split { display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(24px, 5vw, 80px); align-items: center; }
  .split__img { overflow: hidden; aspect-ratio: 4 / 5; }
  .split__img img { width: 100%; height: 120%; object-fit: cover; }
  .split__text p { font-size: clamp(18px, 1.6vw, 22px); margin: 0 0 1.2em; max-width: 44ch; }
  .facts { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-top: clamp(100px, 12vw, 180px); border-top: 1px solid var(--line); padding-top: 30px; }
  .facts__n { display: block; font-size: clamp(56px, 8vw, 120px); letter-spacing: -0.05em; line-height: 1; margin-bottom: 10px; }
  @media (max-width: 820px) { .split { grid-template-columns: 1fr; } .facts { grid-template-columns: 1fr 1fr; } }
</style>
