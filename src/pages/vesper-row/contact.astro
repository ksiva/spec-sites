---
import Layout from "../../layouts/Vesper.astro";
---
<Layout title="Contact" active="Contact" description="Send Vesper Row a brief, a script or a question.">
  <header class="page-head">
    <h1 data-split>Let's make something.</h1>
  </header>
  <section class="grid wrap">
    <div data-reveal="stagger">
      <div class="row"><span class="mono">New work</span><a href="#" class="big">hello@vesperrow.example</a></div>
      <div class="row"><span class="mono">Space bookings</span><a href="#" class="big">stages@vesperrow.example</a></div>
      <div class="row"><span class="mono">Representation</span><p>Canada: in-house<br/>United States: in-house</p></div>
    </div>
    <form class="form" data-reveal="stagger" onsubmit="event.preventDefault(); this.querySelector('button').textContent='Sent (demo)';">
      <label>Name<input required name="name" autocomplete="name" /></label>
      <label>Email<input required type="email" name="email" autocomplete="email" /></label>
      <label>What are you making?<textarea name="msg" rows="4"></textarea></label>
      <button class="btn" data-magnetic>Send brief</button>
      <p class="mono">Demo form on a concept site. Nothing is sent.</p>
    </form>
  </section>
</Layout>
<style>
  .page-head h1 { font-size: clamp(48px, 9vw, 150px); max-width: 12ch; }
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 6vw, 100px); }
  .row { padding: 22px 0; border-bottom: 1px solid var(--line); }
  .row p { margin: 8px 0 0; }
  .big { display: block; font-size: clamp(22px, 2.6vw, 38px); letter-spacing: -0.02em; margin-top: 8px; }
  .form { display: grid; gap: 20px; }
  .form label { display: grid; gap: 8px; font-size: 14px; color: var(--dim); }
  .form input, .form textarea { background: transparent; border: 0; border-bottom: 1px solid var(--line); color: var(--fg); font: inherit; font-size: 20px; padding: 10px 0; outline: none; transition: border-color .3s; }
  .form input:focus, .form textarea:focus { border-color: var(--accent); }
  .btn { justify-self: start; background: var(--fg); color: var(--bg); border: 0; padding: 20px 32px; border-radius: 99px; font: inherit; font-size: 17px; }
  @media (max-width: 820px) { .grid { grid-template-columns: 1fr; } }
</style>
