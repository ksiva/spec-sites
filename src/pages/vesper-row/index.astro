---
import Layout from "../../layouts/Vesper.astro";
import data from "../../data/vesper.json";
import { url, media, formatDate } from "../../lib.js";
const dir = Object.fromEntries(data.directors.map((d) => [d.slug, d]));
const featured = data.featured.map((s) => data.work.find((w) => w.slug === s));
---
<Layout>
  <h1 class="sr-only">Vesper Row: {data.tagline}</h1>

  <section class="ri" id="ri">
    <canvas class="ri__gl" aria-hidden="true"></canvas>
    <div class="ri__videos" aria-hidden="true">
      {featured.map((w, i) => <video src={media(w.loop)} poster={media(w.still)} muted loop playsinline preload={i === 0 ? "auto" : "metadata"}></video>)}
    </div>
    <div class="ri__shade"></div>

    <ol class="ri__list" aria-label="Featured films">
      {featured.map((w, i) => (
        <li class:list={["ri__item", { "is-active": i === 0 }]} data-i={i}>
          <a href={url(`/vesper-row/directors/${w.director}/`)}>
            <span class="ri__n mono">{String(i + 1).padStart(2, "0")}</span>
            <span class="ri__t">{w.title}</span>
            <span class="ri__d">{dir[w.director].name}<em> · {w.client}</em></span>
          </a>
          <span class="ri__progress"></span>
        </li>
      ))}
    </ol>
    <div class="ri__dots" aria-label="Choose a film">
      {featured.map((w, i) => <button class:list={["ri__dot", { "is-active": i === 0 }]} data-i={i} aria-label={`Show ${w.title}`}></button>)}
    </div>

    <div class="ri__side">
      <p class="ri__tag">{data.tagline}</p>
      <button class="ri__play" id="play" data-magnetic data-cursor="Play">
        <span class="ri__play-dot"></span><span>Play the reel</span>
      </button>
    </div>
    <span class="ri__scroll mono">Scroll</span>
  </section>

  <dialog class="player" id="player" aria-label="Vesper Row reel">
    <video src={media(data.reel)} controls playsinline preload="none"></video>
    <button class="player__close mono">Close</button>
  </dialog>

  <section class="statement wrap">
    <p class="mono">{data.cities}</p>
    <p class="statement__t" data-split>We produce commercials for brands that want them to feel like films. Small crews, real locations, directors who shoot what they believe in.</p>
  </section>

  <section class="roster" id="roster">
    <div class="roster__bg" aria-hidden="true">
      {data.directors.map((d, i) => <video src={media(d.loop)} poster={media(d.cover)} muted loop playsinline preload="none" class:list={[{ on: i === 0 }]}></video>)}
    </div>
    <div class="roster__inner wrap">
      <div class="roster__head"><p class="mono">Directors</p><a class="more mono" href={url("/vesper-row/directors/")} data-magnetic>Full roster</a></div>
      <ul class="roster__list">
        {data.directors.map((d, i) => (
          <li data-i={i} class:list={[{ "is-on": i === 0 }]}>
            <a href={url(`/vesper-row/directors/${d.slug}/`)} data-cursor="View">
              <span class="roster__name">{d.name}</span>
              <span class="mono">{d.focus}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="news wrap">
    <div class="sec-head">
      <h2 data-split>News</h2>
      <a class="more mono" href={url("/vesper-row/work/#news")} data-magnetic>All news</a>
    </div>
    <div class="news__grid" data-reveal="stagger">
      {data.news.map((n) => (
        <a class="ncard" href={url(`/vesper-row/news/${n.slug}/`)} data-hover-play>
          <div class="ncard__img"><img src={media(n.image)} alt={n.title} loading="lazy" /><video src={media(n.loop)} muted loop playsinline preload="none"></video></div>
          <span class="mono">{formatDate(n.date)}</span>
          <h3>{n.title}</h3>
        </a>
      ))}
    </div>
  </section>
</Layout>

<script>
  import gsap from "gsap";
  import { createReel } from "../../kit/reelgl.js";
  import { loader } from "../../kit/motion.js";

  const ri = document.getElementById("ri")!;
  const videos = [...ri.querySelectorAll<HTMLVideoElement>(".ri__videos video")];
  const items = [...ri.querySelectorAll<HTMLElement>(".ri__item")];
  const dots = [...ri.querySelectorAll<HTMLButtonElement>(".ri__dot")];
  const reel = createReel(ri.querySelector("canvas")!, videos);
  // Warm the other films once the first is playing.
  videos[0].addEventListener("playing", () => videos.slice(1).forEach((v) => (v.preload = "auto")), { once: true });

  const firstFrame = new Promise((r) => (videos[0].readyState >= 3 ? r(0) : videos[0].addEventListener("canplay", r, { once: true })));
  loader(firstFrame, "Vesper Row — Reel 2026").then(() => {
    gsap.from(items, { yPercent: 120, opacity: 0, duration: 1, stagger: 0.06, ease: "expo.out" });
    gsap.from(".ri__side > *", { y: 20, opacity: 0, duration: 1, stagger: 0.08, ease: "power3.out", delay: 0.3 });
  });

  // Auto-advance with a progress line; hovering a title takes over.
  const HOLD = 6;
  let active = 0, paused = false;
  let progress: gsap.core.Tween | undefined;
  const select = (i: number) => {
    active = i;
    items.forEach((el, k) => el.classList.toggle("is-active", k === i));
    dots.forEach((el, k) => el.classList.toggle("is-active", k === i));
    reel.show(i);
    progress?.kill();
    const bar = items[i].querySelector(".ri__progress");
    gsap.set(".ri__progress", { scaleX: 0 });
    progress = gsap.fromTo(bar, { scaleX: 0 }, { scaleX: 1, duration: HOLD, ease: "none", paused, onComplete: () => select((active + 1) % items.length) });
  };
  items.forEach((el, i) => {
    el.addEventListener("pointerenter", () => { paused = true; if (i !== active) select(i); progress?.pause(); });
    el.addEventListener("pointerleave", () => { paused = false; progress?.resume(); });
    el.querySelector("a")?.addEventListener("focus", () => select(i));
  });
  dots.forEach((d, i) => d.addEventListener("click", () => select(i)));
  select(0);

  // Full reel player.
  const player = document.getElementById("player") as HTMLDialogElement;
  const pv = player.querySelector("video")!;
  document.getElementById("play")?.addEventListener("click", () => { player.showModal(); pv.currentTime = 0; pv.play(); });
  player.querySelector(".player__close")?.addEventListener("click", () => player.close());
  player.addEventListener("close", () => pv.pause());

  // Director roster: hovering a name brings their film up behind the list.
  const bg = [...document.querySelectorAll<HTMLVideoElement>(".roster__bg video")];
  document.querySelectorAll<HTMLElement>(".roster__list li").forEach((li) => {
    li.addEventListener("pointerenter", () => {
      const i = Number(li.dataset.i);
      bg.forEach((v, k) => { v.classList.toggle("on", k === i); if (k === i) { v.preload = "auto"; v.play().catch(() => {}); } else v.pause(); });
      document.querySelectorAll(".roster__list li").forEach((x) => x.classList.toggle("is-on", x === li));
    });
  });
  new IntersectionObserver(([e]) => {
    const on = bg.find((v) => v.classList.contains("on"));
    if (!on) return;
    if (e.isIntersecting) { on.preload = "auto"; on.play().catch(() => {}); } else on.pause();
  }).observe(document.getElementById("roster")!);
</script>

<style>
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  .ri { position: relative; height: 100svh; min-height: 560px; overflow: hidden; background: #000; }
  .ri__gl { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .ri__videos { position: absolute; inset: 0; }
  .ri__videos video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; pointer-events: none; }
  .ri__shade { position: absolute; inset: 0; pointer-events: none; background: linear-gradient(90deg, rgba(0,0,0,.55) 0%, rgba(0,0,0,.1) 55%, transparent 100%), linear-gradient(0deg, rgba(0,0,0,.6) 0%, transparent 45%); }

  .ri__list { position: absolute; left: var(--pad); bottom: clamp(28px, 5vw, 64px); margin: 0; padding: 0; list-style: none; width: min(780px, 70vw); }
  .ri__item { position: relative; overflow: hidden; }
  .ri__item a { display: grid; grid-template-columns: 44px auto 1fr; align-items: baseline; gap: 14px; padding: 6px 0; }
  .ri__t { font-size: clamp(34px, 4.6vw, 76px); font-weight: 500; letter-spacing: -0.045em; line-height: 1; color: rgba(237,233,227,.28); transition: color .5s, transform .7s cubic-bezier(.2,.8,.2,1); }
  .ri__d { font-size: 14px; color: rgba(237,233,227,0); transition: color .5s; white-space: nowrap; }
  .ri__d em { font-style: normal; opacity: .7; }
  .ri__item.is-active .ri__t { color: var(--fg); transform: translateX(10px); }
  .ri__item.is-active .ri__d { color: var(--fg); }
  .ri__item.is-active .ri__n { color: var(--accent); }
  .ri__progress { position: absolute; left: 58px; right: 0; bottom: 0; height: 1px; background: var(--accent); transform-origin: left; transform: scaleX(0); }

  .ri__side { position: absolute; right: var(--pad); bottom: clamp(28px, 5vw, 64px); display: grid; justify-items: end; gap: 22px; max-width: 280px; text-align: right; }
  .ri__tag { margin: 0; font-size: 16px; color: rgba(237,233,227,.85); }
  .ri__play { display: inline-flex; align-items: center; gap: 12px; background: rgba(237,233,227,.08); backdrop-filter: blur(10px); border: 1px solid rgba(237,233,227,.25); color: var(--fg); font: inherit; font-size: 15px; padding: 16px 22px; border-radius: 99px; }
  .ri__play-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 0 rgba(201,180,138,.6); animation: pulse 2s infinite; }
  @keyframes pulse { 70% { box-shadow: 0 0 0 12px rgba(201,180,138,0); } 100% { box-shadow: 0 0 0 0 rgba(201,180,138,0); } }
  .ri__scroll { position: absolute; left: 50%; bottom: 18px; transform: translateX(-50%); color: rgba(237,233,227,.5); }

  .ri__dots { display: none; }
  @media (max-width: 820px) {
    .ri__list { width: auto; right: var(--pad); bottom: 128px; }
    .ri__tag { display: none; }
    .ri__item:not(.is-active) { display: none; }
    .ri__item.is-active .ri__t { transform: none; font-size: clamp(44px, 13vw, 64px); }
    .ri__dots { display: flex; gap: 10px; position: absolute; left: var(--pad); bottom: 108px; }
    .ri__dot { position: relative; width: 26px; height: 3px; border: 0; padding: 0; background: rgba(237,233,227,.3); border-radius: 2px; }
    .ri__dot::before { content: ""; position: absolute; inset: -20px -6px; } /* 44px-tall tap area */
    .ri__dot.is-active { background: var(--accent); }
    .ri__item a { grid-template-columns: 30px 1fr; }
    .ri__d { grid-column: 2; font-size: 12px; }
    .ri__t { font-size: clamp(30px, 9vw, 44px); }
    .ri__progress { left: 44px; }
    .ri__side { left: var(--pad); right: var(--pad); justify-items: start; text-align: left; max-width: none; bottom: 34px; gap: 14px; }
    .ri__scroll { display: none; }
  }

  .player { width: min(94vw, 1500px); padding: 0; border: 0; background: #000; }
  .player::backdrop { background: rgba(0,0,0,.94); }
  .player video { width: 100%; display: block; }
  .player__close { position: fixed; top: 22px; right: var(--pad); background: none; border: 1px solid var(--dim); color: var(--fg); padding: 10px 16px; border-radius: 99px; }

  .statement { padding-top: clamp(120px, 14vw, 220px); }
  .statement__t { font-size: clamp(30px, 4.6vw, 76px); letter-spacing: -0.035em; line-height: 1.04; max-width: 21ch; margin: 24px 0 0; }

  .roster { position: relative; margin-top: clamp(120px, 14vw, 220px); min-height: 100svh; display: grid; align-items: center; overflow: hidden; }
  .roster__bg { position: absolute; inset: 0; }
  .roster__bg video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transform: scale(1.08); transition: opacity 1s, transform 2.4s cubic-bezier(.2,.8,.2,1); filter: brightness(.55); }
  .roster__bg video.on { opacity: 1; transform: scale(1); }
  .roster::after { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(0,0,0,.6), rgba(0,0,0,.15) 70%); pointer-events: none; }
  .roster__inner { position: relative; z-index: 1; width: 100%; padding-top: 80px; padding-bottom: 80px; }
  .roster__head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; }
  .roster__list { list-style: none; margin: 0; padding: 0; }
  .roster__list a { display: flex; justify-content: space-between; align-items: baseline; gap: 20px; flex-wrap: wrap; padding: 10px 0; border-bottom: 1px solid rgba(237,233,227,.18); }
  .roster__name { font-size: clamp(46px, 9.5vw, 168px); font-weight: 500; letter-spacing: -0.06em; line-height: .92; color: rgba(237,233,227,.32); transition: color .5s, transform .8s cubic-bezier(.2,.8,.2,1); }
  .roster__list li.is-on .roster__name, .roster__list a:hover .roster__name { color: var(--fg); transform: translateX(18px); }
  .roster__list .mono { color: rgba(237,233,227,.7); }

  .sec-head { display: flex; align-items: flex-end; justify-content: space-between; margin: clamp(100px, 12vw, 180px) 0 32px; }
  .sec-head h2 { font-size: clamp(44px, 8vw, 120px); }
  .more { color: var(--fg); border: 1px solid rgba(237,233,227,.25); padding: 12px 18px; border-radius: 99px; display: inline-block; }
  .news__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .ncard__img { position: relative; aspect-ratio: 16 / 10; overflow: hidden; margin-bottom: 14px; background: #151515; }
  .ncard__img img, .ncard__img video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 1s cubic-bezier(.2,.8,.2,1), opacity .5s; }
  .ncard__img video { opacity: 0; }
  .ncard:hover video, .is-playing video { opacity: 1; }
  .ncard:hover img, .ncard:hover video { transform: scale(1.05); }
  .ncard h3 { font-size: 24px; line-height: 1.15; margin-top: 8px; letter-spacing: -0.02em; }
  @media (max-width: 820px) { .news__grid { grid-template-columns: 1fr; } }
</style>
