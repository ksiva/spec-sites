---
import Layout from "../../../layouts/Vesper.astro";
import data from "../../../data/vesper.json";
import { url, media } from "../../../lib.js";
export function getStaticPaths() {
  return data.directors.map((d) => ({ params: { slug: d.slug }, props: { d } }));
}
const { d } = Astro.props;
const films = data.work.filter((w) => w.director === d.slug);
---
<Layout title={d.name} active="Directors" description={d.bio}>
  <section class="top">
    <video src={media(d.loop)} poster={media(d.cover)} autoplay muted loop playsinline></video>
    <div class="top__shade"></div>
    <div class="top__text">
      <a class="kit-back" href={url("/vesper-row/directors/")}>← All directors</a>
      <span class="mono" data-page-in>{d.focus}</span>
      <h1 data-split>{d.name}</h1>
    </div>
  </section>
  <p class="bio wrap" data-reveal>{d.bio}</p>
  <section class="films wrap">
    <p class="mono">Films ({films.length})</p>
    <div class="films__grid" data-reveal="stagger">
      {films.map((w) => (
        <article data-hover-play data-cursor="Play" data-film-src={media(w.loop)} data-film-title={w.title} data-film-meta={`${w.client} · ${d.name} · ${w.year}`} aria-label={`Play ${w.title}`}>
          <div class="m"><img src={media(w.still)} alt={`Still from ${w.title} for ${w.client}`} loading="lazy" /><video src={media(w.loop)} muted loop playsinline preload="none"></video></div>
          <h2>{w.title}</h2><span class="mono">{w.client} · {w.year}</span>
        </article>
      ))}
    </div>
  </section>
  <a class="back wrap mono" href={url("/vesper-row/directors/")}>← All directors</a>
</Layout>
<style>
  .top { position: relative; height: 86svh; min-height: 460px; overflow: hidden; }
  .top video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .top__shade { position: absolute; inset: 0; background: linear-gradient(180deg, transparent 40%, rgba(0,0,0,.75)); }
  .top__text { position: absolute; left: var(--pad); right: var(--pad); bottom: clamp(24px, 4vw, 48px); }
  .top h1 { font-size: clamp(56px, 12vw, 200px); letter-spacing: -0.06em; margin-top: 12px; }
  .bio { font-size: clamp(22px, 2.6vw, 40px); line-height: 1.2; letter-spacing: -0.02em; max-width: 28ch; margin: clamp(80px, 9vw, 140px) 0; }
  .films__grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 20px; margin-top: 20px; }
  .m { position: relative; aspect-ratio: 16 / 9; overflow: hidden; background: #151515; margin-bottom: 12px; }
  .m img, .m video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .m video { opacity: 0; transition: opacity .5s; }
  article:hover .m video { opacity: 1; }
  .films h2 { font-size: 24px; margin-bottom: 6px; }
  .back { display: inline-block; margin-top: 80px; color: var(--fg); }
  @media (hover: none) { .is-playing video { opacity: 1; } }
</style>
