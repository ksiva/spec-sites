---
import Layout from "../../layouts/Mira.astro";
import { media } from "../../lib.js";
---
<Layout title="About" active="About" description="Mira Castellane directs commercials and brand films from Toronto.">
  <section class="about wrap">
    <h1 data-split>I started as a camera assistant and never stopped looking through the lens.</h1>
    <div class="cols">
      <div class="img"><img src={media("hd/m-rain.jpg")} alt="Rain running down a window at night, from the film Glass" data-parallax="0.1" /></div>
      <div data-reveal="stagger">
        <p>I direct commercials and brand films from Toronto. Most of my work is fragrance, travel, sport and food: subjects where light and texture carry the story.</p>
        <p>I work with small crews and prefer practical effects. If something can be done for real in front of the camera, I would rather shoot it than fix it later.</p>
        <p class="mono">Directing · Treatments · Casting sessions · Edit supervision · Colour</p>
      </div>
    </div>
  </section>
</Layout>
<style>
  .about { padding-top: clamp(120px, 12vw, 170px); }
  .about h1 { font-size: clamp(40px, 6.6vw, 110px); max-width: 17ch; }
  .cols { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(24px, 5vw, 80px); margin-top: clamp(60px, 8vw, 120px); align-items: start; }
  .img { overflow: hidden; aspect-ratio: 4 / 5; }
  .img img { width: 100%; height: 115%; object-fit: cover; }
  .cols p { font-size: clamp(18px, 1.6vw, 22px); margin: 0 0 1.1em; max-width: 42ch; }
  @media (max-width: 820px) { .cols { grid-template-columns: 1fr; } }
</style>
