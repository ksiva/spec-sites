---
import Layout from "../../../layouts/Mira.astro";
import data from "../../../data/mira.json";
import { url, media } from "../../../lib.js";
export function getStaticPaths() {
  return data.films.map((f) => ({ params: { slug: f.slug }, props: { f } }));
}
const { f } = Astro.props;
const i = data.films.findIndex((x) => x.slug === f.slug);
const next = data.films[(i + 1) % data.films.length];
---
<Layout title={`${f.title} for ${f.client}`} active="Films" description={f.logline}>
  <section class="head wrap">
    <a class="kit-back" href={url("/mira-castellane/#films")}>← All films</a>
    <p class="mono" data-page-in>{f.client} · {f.type} · {f.year}</p>
    <h1 data-split>{f.title}</h1>
  </section>
  <section class="player wrap">
    <div class="frame" data-cursor="Pause">
      <video src={media(f.loop)} poster={media(f.still)} autoplay muted loop playsinline></video>
      <span class="ratio mono">{f.ratio}</span>
    </div>
  </section>
  <section class="info wrap">
    <p class="logline" data-reveal>{f.logline}</p>
    <dl data-reveal="stagger">{f.credits.map(([r, n]) => <div><dt class="mono">{r}</dt><dd>{n}</dd></div>)}</dl>
  </section>
  <a class="next wrap" href={url(`/mira-castellane/films/${next.slug}/`)} data-cursor="Next film">
    <span class="mono">Next film</span>
    <span class="next__t">{next.title}</span>
    <img src={media(next.still)} alt={`Still from ${next.title}`} loading="lazy" />
  </a>
</Layout>
<script>
  document.querySelector(".frame")?.addEventListener("click", (e) => {
    const v = (e.currentTarget as HTMLElement).querySelector("video");
    if (v) v.paused ? v.play() : v.pause();
  });
</script>
<style>
  .head { padding-top: clamp(120px, 12vw, 170px); }
  .head h1 { font-size: clamp(72px, 14vw, 240px); line-height: .85; margin-top: 10px; }
  .player { margin-top: 30px; }
  .frame { position: relative; aspect-ratio: 2.39 / 1; background: #000; overflow: hidden; }
  .frame video { width: 100%; height: 100%; object-fit: cover; }
  .ratio { position: absolute; right: 2%; bottom: 6%; color: #cfc8bc; }
  .info { display: grid; grid-template-columns: 1.3fr 1fr; gap: 40px; margin-top: clamp(50px, 7vw, 100px); }
  .logline { font-family: "Instrument Serif", serif; font-size: clamp(28px, 3.2vw, 52px); line-height: 1.1; margin: 0; max-width: 22ch; }
  dl { margin: 0; }
  dl div { display: flex; justify-content: space-between; gap: 16px; padding: 14px 0; border-bottom: 1px solid var(--line); }
  dd { margin: 0; }
  .next { display: grid; grid-template-columns: 1fr auto; align-items: end; gap: 20px; margin-top: clamp(100px, 12vw, 180px); padding-top: 30px; border-top: 1px solid var(--fg); }
  .next .mono { grid-column: 1 / -1; }
  .next__t { font-family: "Instrument Serif", serif; font-size: clamp(56px, 10vw, 160px); line-height: .9; transition: color .4s; }
  .next:hover .next__t { color: var(--accent); font-style: italic; }
  .next img { width: clamp(140px, 22vw, 340px); aspect-ratio: 2.39 / 1; object-fit: cover; transition: transform .8s cubic-bezier(.2,.8,.2,1); }
  .next:hover img { transform: scale(1.06) rotate(-1.5deg); }
  @media (max-width: 820px) { .info { grid-template-columns: 1fr; } .next { grid-template-columns: 1fr; } }
</style>
