---
import Layout from "../../layouts/Mira.astro";
import data from "../../data/mira.json";
import { url, media, formatDate } from "../../lib.js";
---
<Layout>
  <section class="hero" id="hero" data-cursor="Pause">
    <video class="hero__v" src={media(data.reel)} poster={media("hd/m-horses.jpg")} autoplay muted loop playsinline></video>
    <div class="bar bar--top"><span class="mono">Showreel 2026</span><span class="mono" id="tc">00:00:00:00</span></div>
    <div class="bar bar--bottom"><span class="mono">{data.role} · {data.city}</span><span class="mono ratio-label">2.39 : 1</span></div>
    <h1 class="hero__name"><span class="l1" data-split>Mira</span><em class="l2" data-split>Castellane</em></h1>
  </section>

  <section class="intro wrap">
    <p class="intro__t" data-split>{data.intro}</p>
  </section>

  <section class="films" id="films" aria-label="Films">
    <div class="films__head wrap"><p class="mono">Selected films</p><p class="mono"><span id="fcount">01</span> / {String(data.films.length).padStart(2, "0")}</p></div>
    <div class="films__track">
      {data.films.map((f, i) => (
        <a class="film" href={url(`/mira-castellane/films/${f.slug}/`)} data-cursor="Watch" data-i={i}>
          <div class="film__frame">
            <img src={media(f.still)} alt={`Still from ${f.title} for ${f.client}`} loading="lazy" />
            <video src={media(f.loop)} muted loop playsinline preload="none"></video>
          </div>
          <div class="film__meta">
            <span class="mono">{String(i + 1).padStart(2, "0")}</span>
            <h2 class="film__t">{f.title}</h2>
            <span class="film__c">{f.client} · {f.type} · {f.year}</span>
          </div>
        </a>
      ))}
      <div class="films__end">
        <p class="film__t">Seven films.<br /><em>One</em> way of seeing.</p>
        <a class="link mono" href={url("/mira-castellane/about/")} data-magnetic>About Mira →</a>
      </div>
    </div>
  </section>

  <section class="notes wrap">
    <div class="notes__head"><h2 data-split>Notes</h2><a class="link mono" href={url("/mira-castellane/notes/")} data-magnetic>All notes →</a></div>
    <ul class="notes__list" data-reveal="stagger">
      {data.notes.map((n) => (
        <li><a href={url(`/mira-castellane/notes/${n.slug}/`)}><span class="mono">{formatDate(n.date)}</span><span class="notes__t">{n.title}</span><span aria-hidden="true">↗</span></a></li>
      ))}
    </ul>
  </section>
</Layout>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { loader } from "../../kit/motion.js";
  gsap.registerPlugin(ScrollTrigger);
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches && !location.search.includes("motion");

  // Hero: letterbox bars slide in to a true 2.39:1 frame, then the name rises.
  const hero = document.getElementById("hero")!;
  const v = hero.querySelector<HTMLVideoElement>(".hero__v")!;
  // A true 2.39:1 frame on landscape screens; on tall phone screens the bars stop at 10% so the film stays big.
  const barH = () => Math.max(0, Math.min((innerHeight - innerWidth / 2.39) / 2, innerWidth > innerHeight ? Infinity : innerHeight * 0.1));
  const setBars = () => gsap.set(".bar", { height: barH() });
  const ready = new Promise((r) => (v.readyState >= 3 ? r(0) : v.addEventListener("canplay", r, { once: true })));
  loader(ready, "Mira Castellane — Showreel").then(() => {
    if (reduce) { setBars(); return; }
    gsap.fromTo(".bar", { height: 0 }, { height: barH, duration: 1.6, ease: "expo.inOut" });
    gsap.fromTo(v, { scale: 1.15 }, { scale: 1, duration: 2.2, ease: "expo.out" });
  });
  addEventListener("resize", setBars);
  // Scrolling away closes the letterbox a little further, like a curtain.
  if (!reduce) gsap.to(".hero__v", { scale: 1.12, yPercent: 8, ease: "none", scrollTrigger: { trigger: hero, start: "top top", end: "bottom top", scrub: true } });
  hero.addEventListener("click", () => (v.paused ? v.play() : v.pause()));
  const tc = document.getElementById("tc");
  const pad = (n: number) => String(Math.floor(n)).padStart(2, "0");
  gsap.ticker.add(() => { if (tc) tc.textContent = `00:${pad(v.currentTime / 60)}:${pad(v.currentTime % 60)}:${pad((v.currentTime % 1) * 25)}`; });

  // Films: a pinned horizontal gallery on wide screens; the film nearest the centre plays.
  const track = document.querySelector<HTMLElement>(".films__track")!;
  const films = [...document.querySelectorAll<HTMLElement>(".film")];
  const count = document.getElementById("fcount")!;
  const playNearest = () => {
    const mid = innerWidth / 2;
    let best = 0, bestD = Infinity;
    films.forEach((f, i) => { const r = f.getBoundingClientRect(); const d = Math.abs(r.left + r.width / 2 - mid) + (r.bottom < 0 || r.top > innerHeight ? 1e6 : 0); if (d < bestD) { bestD = d; best = i; } });
    films.forEach((f, i) => {
      const vid = f.querySelector("video")!;
      f.classList.toggle("is-on", i === best);
      if (i === best) { vid.preload = "auto"; vid.play().catch(() => {}); } else vid.pause();
    });
    count.textContent = String(best + 1).padStart(2, "0");
  };
  const mm = gsap.matchMedia();
  // Scrolling down moves the films sideways (it only moves when the visitor scrolls, so it stays on with reduced motion).
  mm.add("(min-width: 821px)", () => {
    const tween = gsap.to(track, {
      x: () => -(track.scrollWidth - innerWidth),
      ease: "none",
      scrollTrigger: { trigger: "#films", pin: true, scrub: reduce ? true : 0.3, anticipatePin: 1, end: () => `+=${track.scrollWidth - innerWidth}`, invalidateOnRefresh: true, onUpdate: playNearest },
    });
    // Each frame drifts inside its window as it travels: a slow parallax across the gallery.
    if (!reduce) films.forEach((f) => gsap.fromTo(f.querySelectorAll("img, video"), { xPercent: -6 }, { xPercent: 6, ease: "none", scrollTrigger: { trigger: f, containerAnimation: tween, start: "left right", end: "right left", scrub: true } }));
  });
  addEventListener("scroll", playNearest, { passive: true });
  track.addEventListener("scroll", playNearest, { passive: true });
  playNearest();
</script>

<style>
  .hero { position: relative; height: 100svh; min-height: 520px; overflow: hidden; background: #000; }
  .hero__v { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .bar { position: absolute; left: 0; right: 0; height: 0; background: #000; z-index: 2; display: flex; justify-content: space-between; align-items: center; padding: 0 var(--pad); overflow: hidden; }
  .bar--top { top: 0; align-items: flex-end; padding-bottom: 10px; }
  .bar--bottom { bottom: 0; align-items: flex-start; padding-top: 10px; }
  .bar .mono { color: #9b9388; }
  .hero__name { position: absolute; z-index: 3; left: var(--pad); right: var(--pad); bottom: 50%; transform: translateY(50%); text-align: center; pointer-events: none; font-size: clamp(64px, 13vw, 240px); line-height: .82; color: #f3ede3; text-shadow: 0 2px 40px rgba(0,0,0,.35); }
  .hero__name .l1, .hero__name .l2 { display: block; }
  .hero__name em { font-style: italic; color: var(--accent); }
  .hero::after { content: ""; position: absolute; inset: 0; z-index: 1; pointer-events: none; background: radial-gradient(ellipse 55% 45% at 50% 50%, rgba(0,0,0,.5), transparent 75%); }
  @media (orientation: portrait) { .ratio-label { display: none; } }

  .intro { padding: clamp(120px, 14vw, 220px) var(--pad) 0; }
  .intro__t { font-family: "Instrument Serif", serif; font-size: clamp(32px, 4.8vw, 84px); line-height: 1.04; max-width: 20ch; margin: 0 auto; text-align: center; }

  .films { margin-top: clamp(120px, 14vw, 200px); min-height: 100svh; display: grid; align-content: center; overflow: hidden; }
  .films__head { display: flex; justify-content: space-between; margin-bottom: 26px; }
  .films__head p { margin: 0; }
  .films__track { display: flex; gap: 4vw; padding: 0 var(--pad); width: max-content; align-items: center; }
  .film { width: min(46vw, 820px); flex: none; }
  .film__frame { position: relative; aspect-ratio: 2.39 / 1; overflow: hidden; background: #000; }
  .film__frame img, .film__frame video { position: absolute; left: -8%; top: -3%; width: 116%; height: 106%; max-width: none; object-fit: cover; transition: opacity .6s, filter .8s; }
  .film__frame img { filter: grayscale(.6) brightness(.7); }
  .film__frame video { opacity: 0; }
  .film.is-on .film__frame video { opacity: 1; }
  .film__meta { display: grid; grid-template-columns: 40px 1fr; gap: 4px 12px; align-items: baseline; padding-top: 18px; }
  .film__t { font-family: "Instrument Serif", serif; font-size: clamp(40px, 5vw, 92px); line-height: .95; transition: color .4s; }
  .film__c { grid-column: 2; color: var(--dim); font-size: 14px; }
  .film:hover .film__t, .film.is-on .film__t { color: var(--accent); font-style: italic; }
  .films__end { width: min(32vw, 480px); flex: none; display: grid; gap: 30px; align-content: center; }
  .films__end em { color: var(--accent); }
  .link { color: var(--fg); border: 1px solid var(--line); border-radius: 99px; padding: 12px 18px; justify-self: start; display: inline-block; }

  /* Reduced motion: no pinning; the gallery is a plain strip you can scroll or swipe sideways. */
  :global(html.films-free) .films { min-height: 0; }
  :global(html.films-free) .films__track { width: auto; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 16px; scrollbar-width: thin; scrollbar-color: #4a453e transparent; }
  :global(html.films-free) .film, :global(html.films-free) .films__end { scroll-snap-align: start; }
  @media (max-width: 820px) {
    .films { min-height: 0; }
    .films__track { flex-direction: column; width: auto; gap: 60px; }
    .film, .films__end { width: 100%; }
    .film__frame img, .film__frame video { inset: 0; width: 100%; height: 100%; }
  }

  .notes { margin-top: clamp(120px, 14vw, 200px); }
  .notes__head { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 24px; }
  .notes__head h2 { font-size: clamp(56px, 9vw, 150px); }
  .notes__list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .notes__list a { display: grid; grid-template-columns: 200px 1fr auto; gap: 20px; align-items: baseline; padding: 24px 0; border-bottom: 1px solid var(--line); }
  .notes__t { font-family: "Instrument Serif", serif; font-size: clamp(26px, 3.2vw, 50px); line-height: 1.05; transition: color .3s; }
  .notes__list a:hover .notes__t { color: var(--accent); font-style: italic; }
  @media (max-width: 720px) { .notes__list a { grid-template-columns: 1fr auto; } .notes__list .mono { grid-column: 1 / -1; } }
</style>
